<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_servicio_guarderia_form" model="ir.ui.view">
        <field name="name">sge.servicio.guarderia.form</field>
        <field name="model">sge.servicio.guarderia</field>
        <field name="arch" type="xml">
            <form string="Servicio de Guardería">
                <sheet>
                    <group>
                        <group string="Monitor (Empleado)">
                            <field name="empleado_id" string="Empleado vinculado"/>
                            <field name="work_email"/>
                            <field name="mobile_phone"/>
                        </group>
                        <group string="Evento (Horario)">
                            <field name="name" string="Asunto del Evento"/>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="location"/>
                            <field name="recurrency" string="¿Es recurrente?"/>
                        </group>
                    </group>
                    <group invisible="not recurrency">
                        <group string="Opciones de Recurrencia">
                            <field name="rrule_type"/>
                            <field name="interval"/>
                            <field name="end_type" widget="radio"/>
                            <field name="count" invisible="end_type != 'count'" required="recurrency and end_type == 'count'"/>
                            <field name="until" invisible="end_type != 'end_date'" required="recurrency and end_type == 'end_date'"/>
                        </group>
                        <group>
                            <div class="o_row">
                                <label for="mon" string="Lun"/><field name="mon"/>
                                <label for="tue" string="Mar"/><field name="tue"/>
                                <label for="wed" string="Mie"/><field name="wed"/>
                                <label for="thu" string="Jue"/><field name="thu"/>
                                <label for="fri" string="Vie"/><field name="fri"/>
                                <label for="sat" string="Sab"/><field name="sat"/>
                                <label for="sun" string="Dom"/><field name="sun"/>
                            </div>
                        </group>
                    </group>
                    <group string="Detalles del Servicio">
                        <field name="descripcion"/>
                        <field name="rango_edad"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_servicio_guarderia_tree" model="ir.ui.view">
        <field name="name">sge.servicio.guarderia.tree</field>
        <field name="model">sge.servicio.guarderia</field>
        <field name="arch" type="xml">
            <list string="Servicios de Guardería">
                <field name="name" string="Monitor"/>
                <field name="start" string="Inicio"/>
                <field name="stop" string="Fin"/>
                <field name="rango_edad"/>
            </list>
        </field>
    </record>

    <record id="action_servicio_guarderia" model="ir.actions.act_window">
        <field name="name">Servicios de Guardería</field>
        <field name="res_model">sge.servicio.guarderia</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_guarderia_root" name="Guardería" sequence="10"/>
    <menuitem id="menu_servicio_guarderia" name="Servicios" parent="menu_guarderia_root" action="action_servicio_guarderia"/>
</odoo>
